{
  /*
   * appsettings.json
   * ----------------
   * Application configuration file.
   * Contains the SQL Server connection string, JWT settings, and LDAP config.
   * NEVER commit production secrets to source control — use environment variables
   * or Azure Key Vault in production.
   */

  "ConnectionStrings": {
    /*
     * SQL Server connection to Mandela University database server.
     * TrustServerCertificate=True is needed because the university server
     * uses a self-signed certificate.
     */
    "DefaultConnection": "Server=soit-sql.mandela.ac.za;Database=PGRS_GRP03;User Id=GRP-03-10;Password=grp-03-10-2026#;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },

  "Jwt": {
    /*
     * Secret key used to sign JWT tokens.
     * Must be at least 32 characters long.
     * Change this in production and store it as an environment variable.
     */
    "Key": "PGRS_GRP03_SECRET_KEY_MANDELA_UNIVERSITY_2026_CHANGE_IN_PROD",
    "Issuer": "PGRS_MANDELA",
    "Audience": "PGRS_USERS",
    /* Token expires after 8 hours (one working day) */
    "ExpiryHours": 8
  },

  "Ldap": {
    /*
     * Active Directory configuration for Mandela University.
     * When Server is empty, the system falls back to local password hashing.
     * Fill this in once IT provides the LDAP server details.
     */
    "Server": "",
    "Port": "389",
    "Domain": "mandela",
    "BaseDn": "DC=mandela,DC=ac,DC=za"
  },

  "FileStorage": {
    /*
     * Where uploaded files (proposals, ethics docs) are stored on the server.
     * Change this to a network share path in production.
     */
    "UploadPath": "Uploads",
    "MaxFileSizeMB": 20
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}